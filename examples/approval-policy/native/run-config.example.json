      "homeBytes": 134217728,
      "tempBytes": 134217728
    },
    "execution": {
      "kind": "deadline",
      "timeoutMs": 120000
    },
    "deadlines": {
      "startupMs": 60000,
      "cleanupMs": 30000
    },
    "transfers": {
      "chunkBytes": 65536,
      "metadataBatchBytes": 65536,
      "metadataMergeFanIn": 8
