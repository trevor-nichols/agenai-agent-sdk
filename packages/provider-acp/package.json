{
  "name": "@agen-ai/provider-acp",
  "version": "0.4.1",
  "private": false,
  "description": "Optional Agent Client Protocol provider for the AgenAI coding-agent runtime.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/**/*.js", "dist/**/*.d.ts", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./node": { "types": "./dist/node/index.d.ts", "import": "./dist/node/index.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:runtime && pnpm run build:types",
    "build:runtime": "tsup",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agen-ai/acp-transport": "workspace:^",
    "@agen-ai/agent-protocol": "workspace:^",
    "@agen-ai/agent-runtime": "workspace:^"
  },
  "devDependencies": { "tsup": "^8.5.0" },
  "engines": { "node": ">=22.0.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevor-nichols/agenai-agent-sdk.git",
    "directory": "packages/provider-acp"
  },
  "homepage": "https://github.com/trevor-nichols/agenai-agent-sdk#readme",
  "bugs": { "url": "https://github.com/trevor-nichols/agenai-agent-sdk/issues" },
  "publishConfig": { "access": "public", "provenance": true }
}
