{
  "name": "@agen-ai/sandbox-docker",
  "version": "0.4.13",
  "private": false,
  "description": "Explicit local Docker Engine resources, policy enforcement and recovery for AgenAI sandboxes.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js", "dist/**/*.d.ts", "README.md", "LICENSE",
    "native/filesystem/helper.c", "native/filesystem/protocol.h", "native/filesystem/operations.c",
    "native/filesystem/filesystem.h", "native/filesystem/transport.c",
    "native/desktop/host/observer.c", "native/desktop/host/observer.h", "native/desktop/vm/observer.c",
    "native/desktop/coordinator/coordinator.h", "native/desktop/coordinator/main.c",
    "native/desktop/coordinator/authority.c", "native/desktop/coordinator/storage.c",
    "native/desktop/recovery/recovery.h", "native/desktop/recovery/main.c", "native/desktop/recovery/wire.c",
    "native/desktop/recovery/profile.h", "native/desktop/recovery/code.c", "native/desktop/recovery/processes.c",
    "native/desktop/recovery/endpoint.c", "native/desktop/recovery/files.c", "native/desktop/recovery/evidence.c",
    "native/desktop/recovery/observation.c"
  ],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./node": { "types": "./dist/node/index.d.ts", "import": "./dist/node/index.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:runtime && pnpm run build:types",
    "build:runtime": "tsup",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agen-ai/sandbox": "workspace:^",
    "@agen-ai/validation": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@agen-ai/agent-protocol": "workspace:^",
    "@agen-ai/agent-runtime": "workspace:^",
    "@agen-ai/provider-acp": "workspace:^",
    "tar-stream": "3.2.2",
    "tsup": "^8.5.0"
  },
  "engines": { "node": ">=22.0.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevor-nichols/agenai-agent-sdk.git",
    "directory": "packages/sandbox-docker"
  },
  "homepage": "https://github.com/trevor-nichols/agenai-agent-sdk#readme",
  "bugs": { "url": "https://github.com/trevor-nichols/agenai-agent-sdk/issues" },
  "publishConfig": { "access": "public", "provenance": true }
}
