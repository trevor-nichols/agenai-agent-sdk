{
  "name": "@agen-ai/acp-registry",
  "version": "0.4.3",
  "private": false,
  "description": "Bounded ACP registry metadata, immutable installation plans, and explicit Node operations.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:runtime && pnpm run build:types",
    "build:runtime": "tsup",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agen-ai/validation": "workspace:^",
    "zod": "catalog:",
    "@openpgp/unbzip2-stream": "2.1.0",
    "buffer-crc32": "1.0.0",
    "tar-stream": "3.2.2",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "@types/yauzl": "3.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevor-nichols/agenai-agent-sdk.git",
    "directory": "packages/acp-registry"
  },
  "homepage": "https://github.com/trevor-nichols/agenai-agent-sdk#readme",
  "bugs": {
    "url": "https://github.com/trevor-nichols/agenai-agent-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
