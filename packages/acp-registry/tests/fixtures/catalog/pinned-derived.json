      "license_url": "https://github.com/vinhnx/VTCode/blob/main/LICENSE",
      "distribution": {
        "binary": {
          "darwin-aarch64": {
            "archive": "https://github.com/vinhnx/VTCode/releases/download/0.96.14/vtcode-0.96.14-aarch64-apple-darwin.tar.gz",
            "cmd": "./vtcode",
            "args": [
              "acp"
            ],
            "env": {
              "VT_ACP_ENABLED": "1",
              "VT_ACP_ZED_ENABLED": "1"
