{
  "name": "@agen-ai/sandbox",
  "version": "0.4.6",
  "private": false,
  "description": "Bounded provider-neutral sandbox ownership, processes, files and recovery contracts.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/**/*.js", "dist/**/*.d.ts", "native/credentials/bootstrap.c", "native/credentials/protocol.h", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./backend": { "types": "./dist/backend/index.d.ts", "import": "./dist/backend/index.js" },
    "./acp": { "types": "./dist/acp/index.d.ts", "import": "./dist/acp/index.js" },
    "./node": { "types": "./dist/node/index.d.ts", "import": "./dist/node/index.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:runtime && pnpm run build:types",
    "build:runtime": "tsup",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": { "@agen-ai/validation": "workspace:^", "zod": "catalog:" },
  "devDependencies": {
    "@agen-ai/agent-protocol": "workspace:^",
    "@agen-ai/agent-runtime": "workspace:^",
    "@agen-ai/provider-acp": "workspace:^",
    "tsup": "^8.5.0"
  },
  "peerDependencies": { "@agen-ai/provider-acp": "workspace:^" },
  "peerDependenciesMeta": { "@agen-ai/provider-acp": { "optional": true } },
  "engines": { "node": ">=22.0.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevor-nichols/agenai-agent-sdk.git",
    "directory": "packages/sandbox"
  },
  "homepage": "https://github.com/trevor-nichols/agenai-agent-sdk#readme",
  "bugs": { "url": "https://github.com/trevor-nichols/agenai-agent-sdk/issues" },
  "publishConfig": { "access": "public", "provenance": true }
}
