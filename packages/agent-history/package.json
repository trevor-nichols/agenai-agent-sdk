{
  "name": "@agen-ai/agent-history",
  "version": "0.4.7",
  "private": false,
  "description": "Provider-neutral native conversation catalogs, transcripts, search and explicit saved-session management.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "import": "./dist/claude.js"
    },
    "./codex": {
      "types": "./dist/codex.d.ts",
      "import": "./dist/codex.js"
    },
    "./opencode": {
      "types": "./dist/opencode.d.ts",
      "import": "./dist/opencode.js"
    },
    "./cursor": {
      "types": "./dist/cursor.d.ts",
      "import": "./dist/cursor.js"
    },
    "./acp": {
      "types": "./dist/acp.d.ts",
      "import": "./dist/acp.js"
    },
    "./grok": {
      "types": "./dist/grok.d.ts",
      "import": "./dist/grok.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:runtime && pnpm run build:types",
    "build:runtime": "tsup",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agen-ai/agent-protocol": "workspace:^",
    "@agen-ai/validation": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@agen-ai/acp-transport": "workspace:^",
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@cursor/sdk": "1.0.40",
    "@openai/codex": "0.163.0",
    "@opencode/cli": "2.1.2",
    "@opencode/client": "2.1.2",
    "@xai-official/grok": "1.0.62",
    "tsup": "^8.5.0"
  },
  "peerDependencies": {
    "@agen-ai/acp-transport": "workspace:^",
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@cursor/sdk": "1.0.40",
    "@opencode/client": "2.1.2"
  },
  "peerDependenciesMeta": {
    "@agen-ai/acp-transport": {
      "optional": true
    },
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@cursor/sdk": {
      "optional": true
    },
    "@opencode/client": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevor-nichols/agenai-agent-sdk.git",
    "directory": "packages/agent-history"
  },
  "homepage": "https://github.com/trevor-nichols/agenai-agent-sdk#readme",
  "bugs": {
    "url": "https://github.com/trevor-nichols/agenai-agent-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
