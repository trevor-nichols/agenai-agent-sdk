{
  "name": "@agen-ai/acp-transport",
  "version": "0.4.3",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "schema/v0.11.4/LICENSE",
    "schema/v0.11.4/meta.json",
    "schema/v0.11.4/meta.unstable.json",
    "schema/v0.11.4/provenance.json",
    "schema/v0.11.4/schema.json",
    "schema/v0.11.4/schema.unstable.json",
    "schema/v0.11.4/protocol.generated.json",
    "schema/schema-v1.23.0/LICENSE",
    "schema/schema-v1.23.0/meta.json",
    "schema/schema-v1.23.0/schema.json",
    "schema/schema-v1.23.0/provenance.json",
    "schema/schema-v1.23.0/protocol.generated.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run check:generated && pnpm run build:runtime && pnpm run build:types",
    "build:runtime": "tsup",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly --outDir dist",
    "check:generated": "node scripts/generate-protocol.mjs --check",
    "generate": "node scripts/generate-protocol.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Bounded, schema-pinned Agent Client Protocol JSON-RPC transport for Node.js hosts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevor-nichols/agenai-agent-sdk.git",
    "directory": "packages/acp-transport"
  },
  "homepage": "https://github.com/trevor-nichols/agenai-agent-sdk#readme",
  "bugs": {
    "url": "https://github.com/trevor-nichols/agenai-agent-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
